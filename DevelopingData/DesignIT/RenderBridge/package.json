{
  "name": "translateit-render-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local RenderBridge for DesignIT visual-first website-to-Figma reconstruction.",
  "scripts": {
    "start": "node server.mjs",
    "payload:final": "node ./src/write-final-payload-report.mjs",
    "pretest:final": "node ./src/run-final-pretest-bundle.mjs",
    "pretest:bundle": "node ./src/run-pretest-quality-bundle.mjs ./reports/translateit-final-payload.json ./reports",
    "render:contract": "node ./src/write-render-contract-report.mjs ./reports/translateit-final-payload.json ./reports/translateit-plugin-render-contract.json",
    "test": "npm run test:imports && npm run test:contract && npm run test:import-contract && npm run test:active-flow && npm run test:workspace-clean && npm run test:desktop-quality && npm run test:golden-samples && npm run test:golden-execution && npm run test:sample",
    "test:imports": "node ./tests/test-module-imports.mjs",
    "test:contract": "node ./tests/test-clean-contract.mjs",
    "test:import-contract": "node ./tests/test-import-contract.mjs",
    "test:active-flow": "node ./tests/test-active-flow.mjs",
    "test:workspace-clean": "node ./tests/test-workspace-clean.mjs",
    "test:desktop-quality": "node ./tests/test-desktop-quality-pass.mjs",
    "test:golden-samples": "node ./tests/test-golden-samples.mjs",
    "test:golden-execution": "node ./tests/test-golden-sample-execution.mjs",
    "test:visual-engine": "node ./tests/test-visual-engine-readiness.mjs",
    "test:figma-dry-run": "node ./tests/test-figma-renderer-dry-run.mjs",
    "test:figma-sim-preview": "node ./tests/test-figma-sim-preview.mjs",
    "test:source-size-parity": "node ./tests/test-source-size-frame-parity.mjs",
    "test:sample": "node ./tests/test-sample-sites.mjs",
    "test:regression": "node ./tests/test-regression-suite.mjs",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.3",
    "yoga-layout": "^3.2.1"
  }
}
