{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translateit.ui-build-package.v1",
  "title": "TranslateIT UI Build Package",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "pluginVersion",
    "source",
    "target",
    "screens",
    "integrationContract"
  ],
  "properties": {
    "schema": {
      "const": "translateit.ui-build-package.v1"
    },
    "generatedAt": {
      "type": "string"
    },
    "pluginVersion": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["figmaPage", "importRun"],
      "properties": {
        "figmaPage": { "type": "string" },
        "importRun": { "type": "string" },
        "exportedRoot": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "readinessLevel": {
          "enum": ["READY", "USABLE_WITH_WARNINGS", "NEEDS_CLEANUP", "BLOCKED", "UNKNOWN"]
        },
        "readinessScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "analysis": {
          "type": "object"
        }
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "componentName": { "type": "string" },
              "svg": { "type": "string" }
            }
          }
        }
      }
    },
    "components": {
      "type": "array"
    },
    "backendBindings": {
      "type": "array"
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "tree"],
        "properties": {
          "name": { "type": "string" },
          "tree": { "type": "object" }
        }
      }
    },
    "integrationContract": {
      "type": "object",
      "required": ["eventAttribute", "stateAttribute", "slotAttribute", "backendAttribute"],
      "properties": {
        "eventAttribute": { "const": "data-action" },
        "stateAttribute": { "const": "data-bind" },
        "slotAttribute": { "const": "data-slot" },
        "backendAttribute": { "const": "data-backend" },
        "note": { "type": "string" }
      }
    }
  }
}
