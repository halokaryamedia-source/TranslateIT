# Root cleanliness guard
/*.py
/*.bat
/*.cmd
/*.ps1
/*.log
/*.tmp
/*.bak
/*.old
/__pycache__/
/.pytest_cache/
/.mypy_cache/
/DeveloperData/

# Python cache
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
DevelopingData/Tooling/Runtime/
DevelopingData/Tooling/ModelCache/
EngineData/LauncherApp/Workers/.venv/

# Runtime logs
*.log
DevelopingData/Documentation/Reports/**/*.log

# User/runtime cache data
UserData/CacheData/*
!UserData/CacheData/
!UserData/CacheData/README.md
UserData/LogData/*
!UserData/LogData/
!UserData/LogData/README.md
UserData/SavedData/*
!UserData/SavedData/
!UserData/SavedData/README.md
!UserData/SavedData/CustomVoice/
UserData/SavedData/CustomVoice/*
!UserData/SavedData/CustomVoice/README.md
!UserData/SavedData/SavedTranscript/
UserData/SavedData/SavedTranscript/*
!UserData/SavedData/SavedTranscript/README.md
UserData/SavedProject/*
!UserData/SavedProject/
!UserData/SavedProject/README.md

# Keep README placeholders if needed
!UserData/README.md

# Audio/generated runtime files
*.wav
*.mp3
*.flac
*.ogg

# Local model/cache data
EngineData/**/ModelCache/
EngineData/**/models/
EngineData/**/ModelData/
*.bin
*.safetensors
