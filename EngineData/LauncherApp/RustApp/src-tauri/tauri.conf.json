{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TranslateIT",
  "version": "0.6.0-rust-tauri-conversion",
  "identifier": "com.halokaryamedia.translateit",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TranslateIT",
        "width": 1200,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
