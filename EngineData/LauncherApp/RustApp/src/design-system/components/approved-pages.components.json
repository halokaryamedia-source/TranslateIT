{
  "$schema": "https://translateit.local/approved-ui-pages.schema.json",
  "meta": {
    "name": "TranslateIT Approved UI Pages",
    "version": "1.0.0",
    "status": "approved-baseline",
    "purpose": "Page-level registry so each approved page can be edited independently without damaging other pages."
  },
  "pages": [
    {
      "id": "main-page",
      "name": "Main Page",
      "status": "approved",
      "module": "../../mainPageLayout.css",
      "scope": [".workspace", ".sidebar"],
      "lockedAgainst": ["settings-page", "audio-settings", "translate-settings", "developer-settings"],
      "figmaFrame": "mainPage"
    },
    {
      "id": "audio-settings",
      "name": "Audio Settings",
      "status": "approved",
      "module": "../../audioSettingsLayout.css",
      "scope": [".settings-view--audio"],
      "lockedAgainst": ["main-page", "translate-settings", "developer-settings"],
      "figmaFrame": "audioSettings"
    },
    {
      "id": "translate-settings",
      "name": "Translate Settings",
      "status": "approved",
      "module": "../../translateSettingsLayout.css",
      "scope": [".settings-view--translate"],
      "lockedAgainst": ["main-page", "audio-settings", "developer-settings"],
      "figmaFrame": "translateSettings"
    },
    {
      "id": "developer-settings",
      "name": "Developer Settings",
      "status": "approved",
      "module": "../../developerSettingsLayout.css",
      "scope": [".settings-view--developer"],
      "lockedAgainst": ["main-page", "audio-settings", "translate-settings"],
      "figmaFrame": "developerSettings"
    }
  ],
  "safeEditRules": [
    "Edit only the module assigned to the approved page.",
    "Do not create global selectors for page-specific changes.",
    "Do not use !important.",
    "When a visual value affects multiple pages, move it into translateit.tokens.json first.",
    "When a page structure changes, update this registry and the Figma export payload."
  ]
}
