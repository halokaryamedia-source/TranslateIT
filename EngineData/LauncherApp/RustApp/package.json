{
  "name": "translateit-rustapp",
  "private": true,
  "version": "0.6.0-rust-tauri-conversion",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "validate:internal": "npm run typecheck && npm run check:rust && npm run build:frontend"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
