{
  "name": "translateit-tauri-desktop-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "setup:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../Backend/LocalWorker/WorkerRuntime/setup_realtime_worker.ps1",
    "smoke:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../Backend/LocalWorker/WorkerRuntime/run_realtime_worker_smoke.ps1",
    "smoke:worker:quality": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../Backend/LocalWorker/WorkerRuntime/run_realtime_worker_smoke.ps1 -Mode Quality -Text halo -TtsText Hello.",
    "smoke:worker:audio": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../Backend/LocalWorker/WorkerRuntime/run_realtime_worker_smoke.ps1 -AudioPath UserData/CacheData/audio_segments/latest_live_target_segment.wav",
    "record:manual-evidence": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs record-manual-evidence",
    "status:all": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_all_status.mjs",
    "status:attachment": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_attachment_status.mjs",
    "status:translation": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_translation_status.mjs",
    "status:audio-pipeline": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_voice_status.mjs",
    "status:contracts": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_contract_status.mjs",
    "status:remaining": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_remaining_status.mjs",
    "status:gap": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_gap_status.mjs",
    "status:readiness": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs summarize-readiness",
    "export:figma-design": "node scripts/export_figma_design_system.mjs",
    "validate:figma-export": "node scripts/validate_figma_export.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "audit:css-priority": "node scripts/audit_css_important.mjs",
    "audit:ui-design": "node scripts/audit_ui_design_system.mjs",
    "validate:security-hardening": "node scripts/validate_security_hardening.mjs",
    "validate:local-hardening": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_local_hardening_validation.ps1",
    "validate:architecture-contracts": "node scripts/validate_architecture_contracts.mjs",
    "validate:single-active-engine": "node scripts/validate_single_active_engine.mjs",
    "validate:userdata-root-policy": "node scripts/validate_userdata_root_policy.mjs",
    "validate:helper-bridge": "node scripts/validate_helper_bridge.mjs",
    "validate:machine-paths": "node scripts/validate_machine_paths.mjs",
    "validate:runtime-flow": "node scripts/validate_runtime_flow.mjs",
    "validate:audio-studio": "node scripts/validate_audio_studio.mjs",
    "validate:audio-studio:local": "node scripts/run_audio_studio_local_validation.mjs",
    "verify:audio-studio:summary": "node scripts/verify_audio_studio_local_summary.mjs",
    "validate:engine-total": "node scripts/validate_engine_total.mjs",
    "validate:auto": "node scripts/run_total_engine_validation.mjs",
    "validate:auto:strict": "node scripts/run_total_engine_validation.mjs --strict",
    "validate:auto:ci": "node scripts/run_total_engine_validation.mjs --ci",
    "validate:auto:worker": "node scripts/run_total_engine_validation.mjs --worker-only",
    "validate:auto:report": "node scripts/run_total_engine_validation.mjs --report-only",
    "validate:root": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-root",
    "validate:structure": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-structure",
    "validate:launcher": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-launcher",
    "validate:worker": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-worker",
    "validate:models": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-models",
    "validate:evidence": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-evidence",
    "validate:ui-reference": "node scripts/validate_ui_reference.mjs",
    "validate:ui-template": "node scripts/validate_ui_template.mjs",
    "validate:internal": "npm run validate:root && npm run validate:structure && npm run validate:launcher && npm run validate:worker && npm run validate:evidence && npm run validate:security-hardening && npm run validate:architecture-contracts && npm run validate:single-active-engine && npm run validate:userdata-root-policy && npm run validate:helper-bridge && npm run validate:machine-paths && npm run validate:runtime-flow && npm run validate:ui-reference && npm run validate:ui-template && npm run validate:audio-studio && npm run audit:deps && npm run audit:ui-design && npm run audit:css-priority && npm run typecheck && npm run check:rust && npm run build:frontend",
    "validate:full": "npm run validate:root && npm run validate:structure && npm run validate:launcher && npm run validate:worker && npm run validate:models && npm run validate:evidence && npm run validate:security-hardening && npm run validate:architecture-contracts && npm run validate:single-active-engine && npm run validate:userdata-root-policy && npm run validate:helper-bridge && npm run validate:machine-paths && npm run validate:runtime-flow && npm run validate:ui-reference && npm run validate:ui-template && npm run validate:audio-studio && npm run audit:deps && npm run audit:ui-design && npm run audit:css-priority && npm run typecheck && npm run check:rust && npm run build:frontend && npm run build && npm run status:readiness"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
