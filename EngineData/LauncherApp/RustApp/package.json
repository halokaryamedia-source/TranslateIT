{
  "name": "translateit-rustapp",
  "private": true,
  "version": "0.8.13-ci-evidence-bundle",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "setup:worker": "powershell -ExecutionPolicy Bypass -File ../Workers/setup_realtime_worker.ps1",
    "smoke:worker": "powershell -ExecutionPolicy Bypass -File ../Workers/run_realtime_worker_smoke.ps1",
    "record:manual-evidence": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/record_rustapp_manual_runtime_evidence.py",
    "status:readiness": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/summarize_translateit_readiness.py",
    "validate:launcher": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/check_launcher_contract.py",
    "validate:ci-workflow": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/check_ci_validation_workflow.py",
    "validate:worker": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/check_local_realtime_worker_stack.py",
    "validate:models": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/check_local_runtime_models.py",
    "validate:frontend-contract": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/check_frontend_runtime_contract.py",
    "validate:evidence": "python ../../../DevelopingData/ToolKitData/Scripts/Execution/check_rust_validation_evidence_boundary.py",
    "validate:internal": "npm run validate:launcher && npm run validate:ci-workflow && npm run validate:worker && npm run validate:frontend-contract && npm run validate:evidence && npm run typecheck && npm run check:rust && npm run build:frontend",
    "validate:full": "npm run validate:launcher && npm run validate:ci-workflow && npm run validate:worker && npm run validate:models && npm run validate:frontend-contract && npm run validate:evidence && npm run typecheck && npm run check:rust && npm run build:frontend && npm run build && npm run status:readiness"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
