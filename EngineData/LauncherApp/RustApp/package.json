{
  "name": "translateit-rustapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "setup:worker": "powershell -NoProfile -File ../Workers/setup_realtime_worker.ps1",
    "smoke:worker": "powershell -NoProfile -File ../Workers/run_realtime_worker_smoke.ps1",
    "smoke:worker:quality": "powershell -NoProfile -File ../Workers/run_realtime_worker_smoke.ps1 -Mode Quality -Text halo -TtsText Hello.",
    "smoke:worker:audio": "powershell -NoProfile -File ../Workers/run_realtime_worker_smoke.ps1 -AudioPath UserData/CacheData/audio_segments/latest_live_target_segment.wav",
    "record:manual-evidence": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs record-manual-evidence",
    "status:gap": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_gap_status.mjs",
    "status:readiness": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs summarize-readiness",
    "validate:root": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-root",
    "validate:structure": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-structure",
    "validate:launcher": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-launcher",
    "validate:worker": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-worker",
    "validate:models": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-models",
    "validate:evidence": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-evidence",
    "validate:internal": "npm run validate:root && npm run validate:structure && npm run validate:launcher && npm run validate:worker && npm run validate:evidence && npm run typecheck && npm run check:rust && npm run build:frontend",
    "validate:full": "npm run validate:root && npm run validate:structure && npm run validate:launcher && npm run validate:worker && npm run validate:models && npm run validate:evidence && npm run typecheck && npm run check:rust && npm run build:frontend && npm run build && npm run status:readiness"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
