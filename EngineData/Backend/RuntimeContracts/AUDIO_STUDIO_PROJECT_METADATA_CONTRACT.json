{
  "schema": "translateit.audio_studio_project_metadata_contract.v1",
  "branch": "Dev-Rust",
  "status": "contract_only",
  "approved_roots": {
    "cache": "UserData/CacheData/AudioStudio/",
    "saved_project": "UserData/SavedProject/AudioStudio/",
    "logs": "UserData/CacheData/AudioStudio/logs/"
  },
  "metadata_files": {
    "take_index": "takes.json",
    "session_index": "sessions.json",
    "evidence_log": "logs/evidence.jsonl"
  },
  "take_fields": [
    "take_id",
    "source",
    "state",
    "title",
    "detail",
    "file_name",
    "size_bytes",
    "reading_line_id",
    "created_unix_ms",
    "updated_unix_ms"
  ],
  "allowed_take_sources": [
    "import",
    "guided_reading"
  ],
  "allowed_take_states": [
    "draft",
    "staged",
    "accepted",
    "needs_retry",
    "blocked"
  ],
  "payload_limits": {
    "take_id_max_chars": 160,
    "take_title_max_chars": 120,
    "take_detail_max_chars": 500,
    "staged_takes_max": 12,
    "import_files_per_action_max": 12,
    "import_file_max_bytes": 524288000,
    "accepted_import_extensions": [
      ".wav",
      ".mp3",
      ".m4a",
      ".ogg",
      ".webm"
    ]
  },
  "rules": [
    "Do not write outside UserData roots.",
    "Do not create additional Audio Studio roots outside CacheData and SavedProject.",
    "Do not mark provider output ready from metadata alone.",
    "Do not claim local capture readiness without target-PC evidence.",
    "Keep imported file metadata separate from generated runtime evidence.",
    "Reject unknown take sources and unknown take states before writing metadata.",
    "Enforce payload_limits before writing Audio Studio metadata."
  ],
  "local_validation_required_before_ready": true
}
