{
  "schema": "translateit.realtime_status_payload.v1",
  "purpose": "Shared payload contract for Rust/Tauri frontend status cards and LocalWorker realtime validation output.",
  "branch": "Dev-Rust",
  "active_app_route": "EngineData/Frontend/RustApp",
  "producer_candidates": [
    "EngineData/Frontend/RustApp/src-tauri/src/commands",
    "EngineData/Frontend/RustApp/src-tauri/src/engine",
    "EngineData/Backend/LocalWorker/WorkerRuntime"
  ],
  "consumer_candidates": [
    "EngineData/Frontend/RustApp/src/app/launcher",
    "EngineData/Frontend/RustApp/src/app/bridge"
  ],
  "payload": {
    "status": {
      "type": "string",
      "allowed": ["idle", "checking", "ready", "partial_ready", "fallback", "error"],
      "description": "Overall realtime pipeline state for UI rendering."
    },
    "language_direction": {
      "type": "string",
      "example": "ID > EN"
    },
    "mode": {
      "type": "string",
      "allowed": ["Realtime", "Quality"]
    },
    "latency": {
      "type": "object",
      "fields": {
        "target_ms": "number",
        "last_total_ms": "number|null",
        "p50_ms": "number|null",
        "sample_count": "number"
      }
    },
    "worker": {
      "type": "object",
      "fields": {
        "available": "boolean",
        "device": "string|null",
        "fallback_active": "boolean",
        "last_command": "string|null"
      }
    },
    "assets": {
      "type": "object",
      "fields": {
        "asr_ready": "boolean",
        "translation_ready": "boolean",
        "tts_ready": "boolean",
        "missing": "string[]"
      }
    },
    "message": {
      "type": "string",
      "description": "Short UI-safe status text."
    },
    "evidence_path": {
      "type": "string|null",
      "description": "Optional validation evidence path under UserData/LogData/RustAppValidation."
    }
  },
  "ui_mapping": {
    "ready": "green status card",
    "partial_ready": "blue or amber status card depending on missing assets",
    "fallback": "amber status card",
    "error": "red status card",
    "idle": "neutral status card",
    "checking": "neutral progress state"
  },
  "notes": [
    "This contract does not claim runtime readiness by itself.",
    "Local validation evidence is required before product readiness is upgraded.",
    "Old Python app-main patching is not the Dev-Rust integration path."
  ]
}
