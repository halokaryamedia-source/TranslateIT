{
  "schema": "translateit.audio_studio_local_validation_evidence_contract.v1",
  "branch": "Dev-Rust",
  "status": "contract_only",
  "approved_output_root": "UserData/CacheData/AudioStudio/logs/",
  "log_file_pattern": "audio_studio_local_validation_<timestamp>.log",
  "summary_file_pattern": "audio_studio_local_validation_<timestamp>.summary.json",
  "summary_schema": "translateit.audio_studio_local_validation.v1",
  "required_summary_fields": [
    "schema",
    "status",
    "started_at",
    "completed_at",
    "package_root",
    "log_path",
    "summary_path",
    "include_tauri_build",
    "runtime_claim",
    "steps",
    "error_message"
  ],
  "allowed_summary_statuses": [
    "running",
    "passed",
    "failed"
  ],
  "required_runtime_claim": "not_ready_until_target_pc_review",
  "required_step_fields": [
    "name",
    "command",
    "status",
    "started_at",
    "completed_at",
    "exit_code"
  ],
  "allowed_step_statuses": [
    "running",
    "passed",
    "failed"
  ],
  "required_steps": [
    "Audio Studio static validator",
    "TypeScript typecheck",
    "Rust cargo check",
    "Frontend build"
  ],
  "optional_steps": [
    "Tauri build"
  ],
  "rules": [
    "Write validation logs and summaries only under UserData/CacheData/AudioStudio/logs/.",
    "Do not interpret a passed summary as runtime readiness without target-PC review.",
    "Record failed validation steps with error_message and non-zero process exit code.",
    "Keep summary files JSON-readable and stable for comparison between local validation runs."
  ]
}
