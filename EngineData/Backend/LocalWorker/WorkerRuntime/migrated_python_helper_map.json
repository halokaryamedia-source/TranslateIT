{
  "schema": "translateit.dev_rust.migrated_python_helper_map.v1",
  "purpose": "Classify Python helper files migrated during branch repair so they do not replace Rust/Tauri app logic.",
  "active_app_route": "EngineData/LauncherApp/RustApp",
  "active_backend_boundary": "EngineData/Backend/LocalWorker/WorkerRuntime",
  "runtime_contracts_route": "EngineData/Backend/RuntimeContracts",
  "runtime_assets_route": "EngineData/Backend/RuntimeAssets",
  "policy": {
    "rust_tauri_is_active_app": true,
    "python_helpers_are_not_primary_app_logic": true,
    "worker_boundary_required_for_runtime_use": true,
    "direct_rustapp_import_blocked": true
  },
  "helper_groups": {
    "language_quality_helpers": {
