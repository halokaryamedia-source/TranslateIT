{
  "name": "translateit-tauri-desktop-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:app": "tauri dev",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "check:rust": "node scripts/validate_rust_manifest_preflight.mjs",
    "check:tauri-rust-local": "node scripts/run_local_tauri_compile_check.mjs",
    "preflight:frontend-build": "node scripts/validate_frontend_build_preflight.mjs",
    "preflight:tauri-package": "node scripts/validate_tauri_package_preflight.mjs",
    "validate:script-profiles": "node scripts/validate_script_profiles.mjs",
    "validate:imports": "node scripts/validate_frontend_import_integrity.mjs",
    "validate:naming": "node scripts/validate_file_naming_policy.mjs",
    "validate:translation-flow": "node scripts/validate_translation_flow_integrity.mjs",
    "validate:runtime-ux": "node scripts/validate_runtime_ux_depth_integrity.mjs",
    "validate:simple-ui": "node scripts/validate_simple_ui_contract.mjs",
    "validate:startup-readiness": "node scripts/validate_startup_runtime_readiness.mjs",
    "validate:ci-scope": "node scripts/validate_v1_advance_ci_scope.mjs",
    "validate:virtual-route": "node scripts/validate_virtual_route_contract.mjs",
    "validate:source-contracts": "npm run validate:script-profiles && npm run validate:imports && npm run validate:naming && npm run validate:translation-flow && npm run validate:runtime-ux && npm run validate:simple-ui && node scripts/validate_functional_surface_contract.mjs && node scripts/validate_runtime_readiness_scenarios.mjs && node scripts/validate_error_feedback_contract.mjs && node scripts/validate_settings_surface_contract.mjs && npm run validate:startup-readiness && npm run validate:ci-scope && npm run validate:virtual-route && npm run check:rust && npm run preflight:frontend-build",
    "validate:quick": "npm run validate:source-contracts && npm run typecheck",
    "test:contract-reports": "node scripts/run_contract_reports.mjs",
    "test:auto-map": "node scripts/run_auto_test_matrix.mjs",
    "test:auto-strict": "node scripts/run_auto_test_matrix.mjs --strict"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
