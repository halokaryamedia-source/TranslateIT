{
  "name": "translateit-tauri-desktop-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "repair:text-real-worker": "node scripts/repair_text_translation_real_worker_flow.mjs",
    "validate:script-profiles": "node scripts/validate_script_profiles.mjs",
