    "verify:audio-studio:summary": "node scripts/verify_audio_studio_local_summary.mjs",
    "validate:engine-total": "node scripts/validate_engine_total.mjs",
    "validate:auto": "node scripts/run_total_engine_validation.mjs",
    "validate:auto:strict": "node scripts/run_total_engine_validation.mjs --strict",
    "validate:auto:ci": "node scripts/run_total_engine_validation.mjs --ci",
    "validate:auto:worker": "node scripts/run_total_engine_validation.mjs --worker-only",
    "validate:auto:report": "node scripts/run_total_engine_validation.mjs --report-only",
