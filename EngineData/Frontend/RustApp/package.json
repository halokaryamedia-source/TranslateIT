    "test:settings-integrity-report": "node scripts/run_settings_integrity_report.mjs",
    "test:professional-gate": "node scripts/run_professional_gate_report.mjs",
    "test:local-final": "npm run repair:text-real-worker && npm run validate:quick && npm run test:package-script-integrity && npm run test:frontend-backend-contract && npm run test:worker-contract && npm run test:rust-linkage-report && npm run test:accelerated-worker-usage && npm run test:runtime-report && npm run test:voice-report && npm run test:voice-capture-evidence && npm run test:ui-readiness-report && npm run test:ui-binding-report && npm run test:action-binding-report && npm run test:settings-integrity-report && npm run test:professional-gate",
