    "export:figma-design": "node scripts/export_figma_design_system.mjs",
    "validate:figma-export": "node scripts/validate_figma_export.mjs",
    "models:inventory": "node scripts/model_inventory.mjs",
    "models:find-existing": "node scripts/find_existing_models.mjs",
    "models:reconcile": "node scripts/reconcile_models.mjs",
    "models:audit-duplicates": "node scripts/audit_model_duplicates.mjs",
    "models:setup": "node scripts/model_setup.mjs",
    "models:setup:asr-primary": "node scripts/model_setup.mjs --model faster-whisper-large-v3-turbo",
    "models:verify": "node scripts/model_verify.mjs",
    "models:verify:asr-primary": "node scripts/model_verify.mjs --model faster-whisper-large-v3-turbo",
    "gpu:check": "node scripts/check_cuda_runtime.mjs",
    "gpu:setup-torch-cuda": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../Backend/LocalWorker/WorkerRuntime/setup_pytorch_cuda.ps1",
    "gpu:setup-torch-cuda:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../Backend/LocalWorker/WorkerRuntime/setup_pytorch_cuda.ps1 -Apply",
    "validate:route-visibility": "node scripts/validate_route_visibility_css.mjs",
    "validate:ui-buttons": "node scripts/validate_ui_buttons.mjs",
    "validate:user-flow": "node scripts/validate_user_flow_trace.mjs",
    "validate:gpu-policy": "node scripts/validate_gpu_policy.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "audit:css-priority": "node scripts/audit_css_important.mjs",
    "audit:ui-design": "node scripts/audit_ui_design_system.mjs",
    "validate:security-hardening": "node scripts/validate_security_hardening.mjs",
    "validate:local-hardening": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_local_hardening_validation.ps1",
    "validate:architecture-contracts": "node scripts/validate_architecture_contracts.mjs",
    "validate:single-active-engine": "node scripts/validate_single_active_engine.mjs",
    "validate:userdata-root-policy": "node scripts/validate_userdata_root_policy.mjs",
    "validate:helper-bridge": "node scripts/validate_helper_bridge.mjs",
    "validate:voice-capture": "node scripts/validate_voice_capture_flow.mjs",
    "validate:settings-navigation": "node scripts/validate_settings_navigation.mjs",
    "validate:machine-paths": "node scripts/validate_machine_paths.mjs",
    "validate:runtime-flow": "node scripts/validate_runtime_flow.mjs",
    "validate:audio-studio": "node scripts/validate_audio_studio.mjs",
