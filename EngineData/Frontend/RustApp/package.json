    "validate:worker": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-worker",
    "validate:models": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-models",
    "validate:evidence": "node ../../../DevelopingData/Tooling/Scripts/Execution/translateit_tooling.mjs validate-evidence",
    "validate:ui-reference": "node scripts/validate_ui_reference.mjs",
    "validate:ui-template": "node scripts/validate_ui_template.mjs",
    "validate:internal": "npm run validate:root && npm run validate:structure && npm run validate:launcher && npm run validate:worker && npm run validate:evidence && npm run validate:security-hardening && npm run validate:architecture-contracts && npm run validate:single-active-engine && npm run validate:userdata-root-policy && npm run validate:helper-bridge && npm run validate:voice-capture && npm run validate:settings-navigation && npm run validate:machine-paths && npm run validate:runtime-flow && npm run validate:ui-reference && npm run validate:ui-template && npm run validate:audio-studio && npm run audit:deps && npm run audit:ui-design && npm run audit:css-priority && npm run typecheck && npm run check:rust && npm run build:frontend",
    "validate:full": "npm run validate:root && npm run validate:structure && npm run validate:launcher && npm run validate:worker && npm run validate:models && npm run validate:evidence && npm run validate:security-hardening && npm run validate:architecture-contracts && npm run validate:single-active-engine && npm run validate:userdata-root-policy && npm run validate:helper-bridge && npm run validate:voice-capture && npm run validate:settings-navigation && npm run validate:machine-paths && npm run validate:runtime-flow && npm run validate:ui-reference && npm run validate:ui-template && npm run validate:audio-studio && npm run validate:user-flow && npm run validate:gpu-policy && npm run audit:deps && npm run audit:ui-design && npm run audit:css-priority && npm run typecheck && npm run check:rust && npm run build:frontend && npm run build && npm run status:readiness && npm run models:find-existing && npm run models:reconcile && npm run models:inventory && npm run models:verify"
  },
