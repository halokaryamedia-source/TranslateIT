{
  "$schema": "https://translateit.local/figma-component-registry.schema.json",
  "meta": {
    "name": "TranslateIT Main Page Components",
    "version": "1.0.0",
    "status": "approved-baseline",
    "sourceCss": "../mainPageLayout.css",
    "reference": "Main Page v28",
    "purpose": "Editable component map for Figma export and safe code-side UI maintenance."
  },
  "page": {
    "id": "main-page",
    "name": "Main Page",
    "frame": {
      "width": 2560,
      "height": 1440,
      "backgroundToken": "color.bg"
    }
  },
  "components": [
    {
      "id": "main-sidebar",
      "name": "Sidebar",
      "scope": ".sidebar",
      "type": "layout-region",
      "editable": ["width", "background", "border", "padding", "sectionSpacing"],
      "lockedAgainst": ["settings-page"],
      "tokens": {
        "width": "layout.mainSidebar",
        "background": "color.sidebar",
        "border": "color.border"
      },
      "children": ["brand", "new-chat-button", "navigation-section", "account-card"]
    },
    {
      "id": "main-topbar",
      "name": "Topbar",
      "scope": ".workspace .topbar",
      "type": "layout-region",
      "editable": ["height", "padding", "title", "statusPills"],
      "lockedAgainst": ["settings-topbar"],
      "tokens": {
        "height": "layout.topbarHeight",
        "background": "color.sidebar",
        "border": "color.border"
      },
      "children": ["direction-pill", "record-pill"]
    },
    {
      "id": "main-hero",
      "name": "Hero Section",
      "scope": ".workspace .hero-panel",
      "type": "content-region",
      "editable": ["width", "kicker", "title", "subtitle", "verticalSpacing"],
      "lockedAgainst": ["settings-view-header"],
      "tokens": {
        "width": "layout.homePanelWidth",
        "titleSize": "typography.heroTitleSize",
        "bodySize": "typography.bodySmallSize"
      },
      "children": ["hero-kicker", "hero-title", "hero-subtitle"]
    },
    {
      "id": "feature-card",
      "name": "Feature Card",
      "scope": ".workspace .feature-card",
      "type": "component",
      "editable": ["minHeight", "padding", "title", "description", "icon", "divider"],
      "lockedAgainst": ["settings-card"],
      "tokens": {
        "surface": "color.surface",
        "border": "color.borderStrong",
        "titleSize": "typography.cardTitleSize",
        "minHeight": "component.mainPage.featureCardMinHeight"
      },
      "variants": ["text-input", "voice-input"]
    },
    {
      "id": "assistant-card",
      "name": "Assistant Card",
      "scope": ".workspace .assistant-card",
      "type": "component",
      "editable": ["minHeight", "padding", "avatar", "title", "message"],
      "lockedAgainst": ["feature-card", "settings-card"],
      "tokens": {
        "surface": "color.surface",
        "border": "color.borderStrong",
        "minHeight": "component.mainPage.assistantCardMinHeight"
      }
    },
    {
      "id": "main-composer",
      "name": "Composer",
      "scope": ".workspace .composer",
      "type": "component",
      "editable": ["width", "height", "radius", "buttonSize", "gap", "placeholder"],
      "lockedAgainst": ["settings-controls"],
      "tokens": {
        "width": "layout.composerWidth",
        "minHeight": "component.mainPage.composerMinHeight",
        "buttonSize": "component.mainPage.composerButtonSize",
        "radius": "radius.composer"
      },
      "children": ["attachment-button", "divider", "message-input", "microphone-button", "send-button"]
    },
    {
      "id": "account-card",
      "name": "Account Card",
      "scope": ".sidebar .account-card",
      "type": "component",
      "editable": ["avatar", "name", "presence", "actionButtons", "spacing"],
      "lockedAgainst": ["workspace", "settings-page"],
      "tokens": {
        "surface": "color.surface2",
        "danger": "color.danger",
        "minHeight": "component.mainPage.accountCardMinHeight"
      }
    }
  ],
  "safeEditRules": [
    "Only selectors scoped with .workspace or .sidebar may affect Main Page.",
    "Never change Settings page selectors from the Main Page component module.",
    "When editing a component, update its token or registry entry first, then update CSS.",
    "Do not add broad selectors such as button, svg, .icon, or .settings-card in this module."
  ]
}
